      </div><button type="submit" class="w-full py-3 rounded-xl text-white font-semibold mb-3" style="background: linear-gradient(135deg, #DC2626 0%, #B91C1C 100%); box-shadow: 0 4px 12px rgba(220, 38, 38, 0.3);"> เข้าสู่ระบบ </button> <button type="button" id="cancel-login" class="w-full py-3 rounded-xl text-gray-600 font-semibold border-2 border-gray-200"> ยกเลิก </button>
     </form>
    </div>
   </div><!-- Admin Dashboard -->
